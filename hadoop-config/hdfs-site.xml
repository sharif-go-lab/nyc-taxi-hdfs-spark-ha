<?xml version="1.0"?>
<configuration>
  <property>
    <name>dfs.nameservices</name>
    <value>taxi</value>
  </property>
  <property>
    <name>dfs.ha.namenodes.taxi</name>
    <value>nn1,nn2</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.taxi.nn1</name>
    <value>namenode1:8020</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.taxi.nn2</name>
    <value>namenode2:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.taxi.nn1</name>
    <value>namenode1:9870</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.taxi.nn2</name>
    <value>namenode2:9870</value>
  </property>
  <property>
    <name>dfs.client.failover.proxy.provider.taxi</name>
    <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
  </property>
  <property>
    <name>dfs.journalnode.edits.dir</name>
    <value>/hadoop/dfs/journalnode</value>
  </property>
  <property>
    <name>dfs.namenode.shared.edits.dir</name>
    <value>qjournal://journalnode1:8485;journalnode2:8485;journalnode3:8485/taxi</value>
  </property>
  <property>
    <name>dfs.ha.automatic-failover.enabled</name>
    <value>true</value>
  </property>
</configuration>
